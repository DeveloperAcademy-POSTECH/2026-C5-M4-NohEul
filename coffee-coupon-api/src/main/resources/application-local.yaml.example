spring:
  application:
    name: coffee-coupon-api
  datasource:
    url: jdbc:mysql://localhost:3306/coffee_coupon?createDatabaseIfNotExist=true
    username: root
    password: your_password_here
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
